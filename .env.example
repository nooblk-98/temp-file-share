# Copy to .env (git-ignored) and adjust. Every value below is the compose default.

# Image tag used by `docker compose pull/up` (build also tags it).
TAG=latest

# Host side
HOST_PORT=34100
# These directories must be owned by uid/gid 10001:  chown -R 10001:10001 <dir>
UPLOADS_HOST_DIR=/opt/temp-file-share/uploads
DATA_HOST_DIR=/opt/temp-file-share/data

# Resource limits
# The app buffers a whole upload (and download) in memory, so the largest file
# you can share is bounded by MEM_LIMIT. Measured with the compose settings:
#   MEM_LIMIT=256m -> 200 MB OK, 400 MB OOM-killed
#   MEM_LIMIT=512m -> 450 MB OK, 500 MB OOM-killed   (default)
# Rule of thumb: MEM_LIMIT >= largest upload + ~64 MB. Uploads are also spooled
# to /tmp (a named volume, so it is not capped by RAM).
MEM_LIMIT=512m
CPU_LIMIT=1.0
PIDS_LIMIT=256

# App config (see app/config.py)
TZ=Asia/Colombo
UPLOAD_DIR=uploads
FILES_DB=data/files_db.json
MAX_STORAGE_GB=50
MAX_AGE_HOURS=5
IP_LIMIT_GB=10
PUBLIC_BASE_URL=https://fs.app.itsnooblk.com
RATE_LIMIT_SECONDS=2
CLEANUP_INTERVAL_SECONDS=300
GEO_IP_ENABLED=true
