# Compose builds from source; it does not pull a published image.
# Bind to loopback for a reverse proxy on this host. For a proxy in Docker,
# prefer a private shared network; do not expose the backend directly.
HOST_BIND=127.0.0.1
HOST_PORT=34100
# These paths must be writable by uid:gid 10001:10001.
UPLOADS_HOST_DIR=/opt/temp-file-share/uploads
DATA_HOST_DIR=/opt/temp-file-share/data
MEM_LIMIT=512m
CPU_LIMIT=1.0
PIDS_LIMIT=256
TZ=Asia/Colombo
UPLOAD_DIR=uploads
FILES_DB=data/files_db.json
MAX_STORAGE_GB=50
MAX_AGE_HOURS=5
IP_LIMIT_GB=10
PUBLIC_BASE_URL=https://fs.app.itsnooblk.com
RATE_LIMIT_SECONDS=2
CLEANUP_INTERVAL_SECONDS=300
# Exact peer IPs/CIDRs of your proxy only. Blank ignores all forwarded headers.
# In Docker the peer may be the bridge gateway, not 127.0.0.1. Inspect it first.
TRUSTED_PROXIES=
MAX_UPLOAD_MB=1024
REQUEST_TIMEOUT_SECONDS=30
MAX_CONNECTIONS=16
