# Copy to .env.dev; use: docker compose --env-file .env.dev -f docker-compose.dev.yaml up -d --pull always
IMAGE_REPOSITORY=ghcr.io/nooblk-98/temp-file-share
DEV_IMAGE_TAG=development
DEV_HOST_BIND=127.0.0.1
DEV_HOST_PORT=34101
DEV_UPLOADS_HOST_DIR=/opt/temp-file-share-dev/uploads
DEV_DATA_HOST_DIR=/opt/temp-file-share-dev/data
DEV_PUBLIC_BASE_URL=http://localhost:34101
DEV_TRUSTED_PROXIES=
MAX_STORAGE_GB=5
IP_LIMIT_GB=1
MAX_AGE_HOURS=5
RATE_LIMIT_SECONDS=2
